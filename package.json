{
  "private": true,
  "name": "core",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "ncu": "ncu --deep",
    "ncu:u": "ncu -u --deep"
  },
  "devDependencies": {
    "@metamask/providers": "^22.1.1",
    "ethers": "^6.17.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsconfig": "workspace:*",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/credenza-web3/credenza-core-web-sdk"
  }
}
