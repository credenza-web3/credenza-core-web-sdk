{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "svelte": true,
  "ignorePatterns": ["pnpm-lock.yaml", "**/dist/**", "**/.svelte-kit/**", "**/build/**", "**/package/**"]
}
