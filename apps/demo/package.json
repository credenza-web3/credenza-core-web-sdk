    "@credenza3/core-web-oauth-ext": "workspace:*",
    "@credenza3/core-web-sui-ext": "workspace:*",
    "@credenza3/core-web-sui-zklogin-ext": "workspace:*",
    "@credenza3/evm-provider": "workspace:*",
    "@farcaster/miniapp-sdk": "^0.4.0",
    "@mysten/sui": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
