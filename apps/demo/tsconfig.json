{
  "extends": ["tsconfig/tsconfig.json", "$app/tsconfig"],
  "compilerOptions": {
    "paths": {
      "@packages/*": ["../../packages/*"]
    },
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  },
  "include": ["src", "tests", "*.ts"],
  "exclude": ["src/service-worker"]
}
